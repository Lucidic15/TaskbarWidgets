<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10/11, so the exe runs without installing a runtime. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RDPLauncher</RootNamespace>
    <AssemblyName>RDPLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/make_icon.py. -->
    <ApplicationIcon>RDPLauncher.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
    <Product>RDPLauncher</Product>
    <Description>Taskbar widget that starts Remote Desktop on the number of displays you pick.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- For reading the monitor list that "mstsc /l" shows (Displays/MstscDisplayIds.cs). -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the project build without the .NET Framework targeting pack installed (including on CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
